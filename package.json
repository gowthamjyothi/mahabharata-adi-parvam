{
  "name": "adi-parva-archive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "esbuild scripts/validate-data.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/validate-data.mjs --log-level=warning && node node_modules/.cache/validate-data.mjs",
    "check:render": "esbuild scripts/render-check.tsx --bundle --platform=node --format=cjs --loader:.tsx=tsx --jsx=automatic --outfile=node_modules/.cache/render-check.cjs --log-level=warning && node node_modules/.cache/render-check.cjs 2>/dev/null"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
